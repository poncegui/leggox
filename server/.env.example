# ================================================
# CONFIGURACIÓN DEL SERVIDOR - Leggox API
# ================================================

# ================================================
# CONFIGURACIÓN DE PAYPAL
# ================================================

# Entorno de PayPal (sandbox o production)
PAYPAL_ENV=sandbox

# Tu Client ID de PayPal (obtén en https://developer.paypal.com)
PAYPAL_CLIENT_ID=tu_client_id_aqui

# Tu Client Secret de PayPal (obtén en https://developer.paypal.com)
# ⚠️  NUNCA hagas push de este archivo con credenciales reales a prod
PAYPAL_CLIENT_SECRET=tu_client_secret_aqui

# ================================================
# PUERTO
# ================================================
# Puerto en el que corre el servidor API
PORT=4000

# ================================================
# NOTAS DE CONFIGURACIÓN
# ================================================

# 1. Ve a https://developer.paypal.com
# 2. Inicia sesión con las credenciales de la empresa
# 3. Ve a "My Apps & Credentials"
# 4. Crea una aplicación en Sandbox (o usa una existente)
# 5. Copia el Client ID y Client Secret
# 6. Pégalos en el archivo .env (NO en .env.example)
# 7. Reinicia el servidor
