# ================================================
# CONFIGURACIÓN DEL FRONTEND - Leggox
# ================================================

# Base URL del servidor API
REACT_APP_API_BASE=http://localhost:4000

# ================================================
# CONFIGURACIÓN DE PAYPAL
# ================================================

# Tu Client ID de PayPal (obtén en https://developer.paypal.com)
# En SANDBOX (pruebas): Tu Client ID de sandbox
# En PRODUCTION: Tu Client ID de producción
REACT_APP_PAYPAL_CLIENT_ID=tu_client_id_aqui

# ⚠️  IMPORTANTE:
# El Client ID es PÚBLICO, puedes ponerlo aquí
# NUNCA publiques el Client Secret en el frontend

# ================================================
# NOTAS
# ================================================

# Los valores vacíos se pueden llenar después
# Recarga el servidor (npm start) después de cambiar .env
# En desarrollo: localhost:3000
# El backend debe estar corriendo en localhost:4000
